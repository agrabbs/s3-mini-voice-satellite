# Copy this file to secrets.yaml and fill in your actual values
# DO NOT commit secrets.yaml to version control!

# WiFi Configuration
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback AP (Access Point) Configuration
ap_password: "fallback-password-12345"

# API Encryption Key
# Generate using: esphome run s3-mini-voice-satellite.yaml
# Or manually: openssl rand -base64 32
api_encryption_key: "your-api-encryption-key-here"

# OTA Update Password
ota_password: "your-ota-password-here"
